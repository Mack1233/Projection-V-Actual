-- Set variables
SET selected_year = 2026;
SET selected_month = 4;

-- Calendar CTE
WITH calendar AS (
  SELECT DATEADD(DAY, seq4(), DATE_FROM_PARTS($selected_year, $selected_month, 1)) AS transaction_date
  FROM TABLE(GENERATOR(ROWCOUNT => 31))
  WHERE DATEADD(DAY, seq4(), DATE_FROM_PARTS($selected_year, $selected_month, 1)) 
        < DATEADD(MONTH, 1, DATE_FROM_PARTS($selected_year, $selected_month, 1))
),

-- Filtered transactions
filtered_transactions AS (
  SELECT 
    TO_DATE(t.PROCESS_DATE) AS transaction_date,
    t.TRANS_TYPE,
    t.AMOUNT,
    t.CLEARED_DATE,
    co.ADDITIONAL4 AS PORTFOLIO
  FROM transactions t
  JOIN contacts c 
    ON c.ID = t.CONTACT_ID
  JOIN COMPANIES co 
    ON c.COMPANY_ID = co.ID
  WHERE 
    EXTRACT(YEAR FROM t.PROCESS_DATE) = $selected_year
    AND EXTRACT(MONTH FROM t.PROCESS_DATE) = $selected_month
    AND t.TRANS_TYPE IN ('D', 'CC')
    AND COALESCE(c.DROPPED, 0) != 1
    AND COALESCE(c.PAUSED, 0) != 1
)

-- Final query
SELECT 
  cal.transaction_date,

  -- ========== BK (ADDITIONAL4 = 1673) ==========
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) AS "BK - $ ACH Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0) AS "BK - Count ACH Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0), 2), 0) AS "BK ACH Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "BK - ACH Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "BK ACH Cleared %",

  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) AS "BK - $ Card Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0) AS "BK - Count Card Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0), 2), 0) AS "BK Card Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "BK - Card Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1673' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "BK Card Cleared %",

  -- ========== ResPro (ADDITIONAL4 = 1697) ==========
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) AS "ResPro - $ ACH Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0) AS "ResPro - Count ACH Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0), 2), 0) AS "ResPro ACH Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "ResPro - ACH Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "ResPro ACH Cleared %",

  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) AS "ResPro - $ Card Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0) AS "ResPro - Count Card Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0), 2), 0) AS "ResPro Card Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "ResPro - Card Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1697' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "ResPro Card Cleared %",

  -- ========== MLG (ADDITIONAL4 = 1698) ==========
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) AS "MLG - $ ACH Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0) AS "MLG - Count ACH Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' THEN 1 END), 0), 2), 0) AS "MLG ACH Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "MLG - ACH Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'D' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "MLG ACH Cleared %",

  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) AS "MLG - $ Card Projection",
  COALESCE(COUNT(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0) AS "MLG - Count Card Projection",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(COUNT(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' THEN 1 END), 0), 2), 0) AS "MLG Card Average Payment",
  COALESCE(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END), 0) AS "MLG - Card Actual",
  COALESCE(ROUND(
    SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' AND ft.CLEARED_DATE IS NOT NULL THEN ft.AMOUNT ELSE 0 END) /
    NULLIF(SUM(CASE WHEN ft.PORTFOLIO = '1698' AND ft.TRANS_TYPE = 'CC' THEN ft.AMOUNT ELSE 0 END), 0) * 100, 2), 0) AS "MLG Card Cleared %"

FROM calendar cal
LEFT JOIN filtered_transactions ft 
  ON cal.transaction_date = ft.transaction_date
GROUP BY cal.transaction_date
ORDER BY cal.transaction_date;
